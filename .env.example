# ═════════════════════════════════════════════════════════════
#  Pokédex API · variables de entorno
#  Copia este fichero a `.env` y rellena los valores reales.
#  El `.env` está en .gitignore: NUNCA debe subirse al repositorio.
# ═════════════════════════════════════════════════════════════

# Entorno de ejecución: development | production | test
ENVIRONMENT=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (formato del enunciado) | json (una línea JSON por registro)
LOG_FORMAT=text
# Fichero de log con rotación; vacío para no escribir fichero
LOG_FILE=pokedex_api.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Clave para firmar los JWT. Genera una aleatoria con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres

# Cadena de conexión a la base de datos (SQLite por defecto, PostgreSQL opcional)
DATABASE_URL=sqlite:///./pokedex.db

# ── JWT ───────────────────────────────────────────────────────
# Solo se admiten algoritmos HMAC: HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
JWT_ISSUER=pokedex-api
JWT_AUDIENCE=pokedex-api-clients
# Validez del access token en minutos (24 h) y del refresh token en días
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Contraseñas e intentos de inicio de sesión ────────────────
# Coste de bcrypt (2^n iteraciones). 12 es un buen equilibrio entre seguridad y tiempo.
BCRYPT_ROUNDS=12
# Fallos seguidos permitidos antes de bloquear la cuenta, y minutos de bloqueo
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── Inicio de sesión con Google (opcional) ────────────────────
# Credenciales de https://console.cloud.google.com/apis/credentials (tipo «Aplicación
# web»). Sin ellas, /auth/google/* responde 503 y el resto de la API funciona igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Adónde vuelve el navegador tras entrar con Google, con los tokens en el fragmento
# (#access_token=...), que nunca se envía a ningún servidor. "/" es la web de la Pokédex;
# vacío, el callback devuelve los tokens en JSON.
OAUTH_SUCCESS_REDIRECT=/

# ── IA: «Profesor Oak» con Groq (opcional) ────────────────────
# Clave gratuita en https://console.groq.com/keys. Sin ella, los endpoints de IA
# responden igualmente con reglas (source: "rules").
GROQ_API_KEY=
# Modelos que se prueban en orden si el anterior falla o agota su cuota
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_CACHE_TTL_SECONDS=3600
RATE_LIMIT_AI=10/minute

# ── Cliente de PokeAPI ────────────────────────────────────────
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Tiempo máximo por petición y reintentos ante errores transitorios (red, 429, 5xx)
POKEAPI_TIMEOUT_SECONDS=5
POKEAPI_MAX_RETRIES=3
# Base del backoff exponencial: espera aleatoria de hasta 0,3 s, 0,6 s, 1,2 s...
POKEAPI_BACKOFF_SECONDS=0.3
# Peticiones simultáneas máximas a PokeAPI
POKEAPI_MAX_CONCURRENCY=10
# Caché en memoria: duración (segundos) y número máximo de respuestas guardadas
POKEAPI_CACHE_TTL_SECONDS=3600
POKEAPI_CACHE_MAX_ENTRIES=2048
# Circuit breaker: fallos seguidos que lo abren y segundos hasta volver a probar
POKEAPI_BREAKER_THRESHOLD=5
POKEAPI_BREAKER_COOLDOWN_SECONDS=30

# ── Rate limiting ─────────────────────────────────────────────
# Formato "N/second|minute|hour|day"; se pueden combinar varios con ";"
RATE_LIMIT_ENABLED=true
# memory:// para un solo proceso; redis://host:6379 si hay varias réplicas
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_TOKEN=30/minute
RATE_LIMIT_EXTERNAL=30/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_DEFAULT=100/minute

# ── CORS ──────────────────────────────────────────────────────
# Orígenes separados por comas. Nunca "*" en producción.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_MAX_AGE_SECONDS=3600

# ── Seguridad HTTP ────────────────────────────────────────────
# Valores aceptados en la cabecera Host (admite *.dominio.com). Nunca "*" en producción.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Tamaño máximo del cuerpo de una petición, en bytes (1 MB)
MAX_BODY_BYTES=1048576
# Duración de HSTS (solo se envía por HTTPS): 2 años
HSTS_MAX_AGE_SECONDS=63072000
# Publicar /docs y /openapi.json
DOCS_ENABLED=true
# Publicar la web de la Pokédex en /
WEB_ENABLED=true

# ── HTTPS (uv run python -m app) ─────────────────────────────
# Interfaz de escucha (0.0.0.0 para toda la red) y puertos. HTTP solo redirige a HTTPS;
# HTTP_REDIRECT_PORT=0 lo desactiva.
SERVER_HOST=127.0.0.1
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
# Carpeta del certificado local, que se genera solo si no existe
TLS_CERT_DIR=certs
# Certificado propio (p. ej. de mkcert); vacíos = el certificado local
TLS_CERTFILE=
TLS_KEYFILE=

# ── Docker (docker compose up) ────────────────────────────────
# Dominio que sirve Caddy en el puerto 443
SITE_HOST=localhost

# ── Versionado ────────────────────────────────────────────────
# GET /api/v1/pokedex: obsoleto desde la primera fecha y retirado (410 Gone) en la segunda
V1_POKEDEX_DEPRECATED_AT=2026-11-09T00:00:00Z
V1_POKEDEX_SUNSET=2027-06-30T23:59:59Z
