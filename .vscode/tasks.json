{
  // Tareas de la Pokédex: Ctrl+Mayús+P → «Tasks: Run Task» (o Terminal → Ejecutar tarea).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pokédex: arrancar (https://localhost)",
      "detail": "La API y la web por HTTPS en el puerto 443. Para pararla: Ctrl+C en su terminal.",
      "type": "shell",
      "command": "uv run python -m app",
      "isBackground": true,
      "problemMatcher": {
        "owner": "pokedex",
        "pattern": { "regexp": "^__nunca__$" },
        "background": {
          "activesBegin": true,
          "beginsPattern": "Pokédex API en",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Pokédex: desarrollo (http://127.0.0.1:8000)",
      "detail": "Recarga sola al guardar cambios en el código. Aquí funciona el login con Google.",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --no-server-header --no-access-log --no-proxy-headers",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always", "clear": true }
    },
    {
      "label": "Pokédex: datos de demo",
      "detail": "Crea (o reinicia) el entrenador «demo» con 47 Pokémon y dos equipos.",
      "type": "shell",
      "command": "uv run python -m scripts.demo --password \"${input:demoPassword}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Pokédex: prueba de humo",
      "detail": "Recorre los 32 endpoints contra la Pokédex arrancada.",
      "type": "shell",
      "command": "uv run python -m scripts.smoke_test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Pokédex: tests",
      "detail": "Todos los tests de Python con cobertura (no hace falta arrancar nada).",
      "type": "shell",
      "command": "uv run pytest --cov=app --cov-report=term-missing",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Pokédex: tests de la web (JavaScript)",
      "detail": "Necesita Node.js 22 o superior.",
      "type": "shell",
      "command": "node --test \"tests/web/*.test.mjs\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true },
      "group": "test"
    }
  ],
  "inputs": [
    {
      "id": "demoPassword",
      "type": "promptString",
      "description": "Contraseña para el usuario «demo» (mayúscula, número y 8 caracteres o más)",
      "password": true
    }
  ]
}
